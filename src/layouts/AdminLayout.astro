---
import {
  CalendarDays,
  CreditCard,
  LayoutDashboard,
  LayoutGrid,
  LogIn,
  ShieldCheck,
  Users,
} from "@lucide/astro";
import { AuthNav } from "../components/nav/AuthNav";
import Logo from "../components/Logo.astro";
import Layout from "./Layout.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Admin Dashboard — SMASH ARENA", description } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/admin";

const navItems = [
  { label: "Dashboard", href: "/admin", icon: LayoutDashboard },
  { label: "Bookings", href: "/admin/bookings", icon: CalendarDays },
  { label: "Customers", href: "/admin/customers", icon: Users },
  { label: "Courts", href: "/admin/courts", icon: LayoutGrid },
  { label: "Payments", href: "/admin/payments", icon: CreditCard },
];

const isActive = (href: string) =>
  href === "/admin" ? pathname === "/admin" : pathname.startsWith(href);
---

<Layout title={title} description={description}>
  <div class="flex min-h-screen flex-col bg-[#0a0b0d]">
    <header class="sticky top-0 z-40 border-b border-white/8 bg-background/85 backdrop-blur-xl">
      <div class="flex h-16 items-center justify-between gap-4 px-4 md:px-6">
        <div class="flex items-center gap-3">
          <a
            href="/"
            class="flex items-center gap-2 rounded-xl outline-none focus-visible:ring-2 focus-visible:ring-ring"
            aria-label="Kembali ke situs Smash Arena"
          >
            <span class="text-primary"><Logo class="size-7" /></span>
            <span
              class="font-display text-base font-extrabold uppercase leading-none tracking-[0.08em]"
            >
              <span class="text-white">Smash</span><span class="text-primary"> Arena</span>
            </span>
          </a>
          <span
            class="hidden items-center gap-1.5 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-primary sm:inline-flex"
          >
            <ShieldCheck class="size-3.5" aria-hidden="true" />
            Admin
          </span>
        </div>

        <div class="flex items-center gap-2.5">
          <a
            href="/login"
            class="hidden h-9 items-center gap-1.5 rounded-full border border-white/15 px-4 text-xs font-bold text-white/75 outline-none transition-colors hover:border-primary/50 hover:text-primary focus-visible:ring-2 focus-visible:ring-ring sm:inline-flex lg:hidden"
          >
            <LogIn class="size-3.5" aria-hidden="true" />
            Login
          </a>
          <AuthNav client:load />
        </div>
      </div>

      <nav
        class="flex gap-1 overflow-x-auto border-t border-white/8 px-3 py-2 lg:hidden"
        aria-label="Navigasi admin mobile"
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "inline-flex shrink-0 items-center gap-1.5 rounded-full px-3.5 py-2 text-xs font-bold outline-none transition-colors focus-visible:ring-2 focus-visible:ring-ring",
                isActive(item.href)
                  ? "bg-primary text-primary-foreground"
                  : "text-white/65 hover:bg-white/5 hover:text-primary",
              ]}
            >
              <item.icon class="size-3.5" aria-hidden="true" />
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <div class="flex flex-1">
      <aside
        class="sticky top-16 hidden h-[calc(100vh-4rem)] w-60 shrink-0 border-r border-white/8 bg-black/25 p-4 lg:block"
        aria-label="Navigasi admin"
      >
        <nav>
          <ul class="space-y-1.5">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class:list={[
                      "flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-semibold outline-none transition-colors focus-visible:ring-2 focus-visible:ring-ring",
                      isActive(item.href)
                        ? "bg-primary/15 text-primary ring-1 ring-primary/30"
                        : "text-white/65 hover:bg-white/5 hover:text-white",
                    ]}
                  >
                    <item.icon class="size-4 shrink-0" aria-hidden="true" />
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <a
          href="/"
          class="mt-4 flex items-center justify-center gap-2 rounded-full border border-white/12 px-4 py-2.5 text-xs font-bold text-white/70 outline-none transition-colors hover:border-primary/45 hover:text-primary focus-visible:ring-2 focus-visible:ring-ring"
        >
          ← Kembali ke Situs
        </a>
      </aside>

      <main id="main" class="min-w-0 flex-1 px-4 py-6 md:px-8 md:py-8">
        <slot />
      </main>
    </div>
  </div>
</Layout>
