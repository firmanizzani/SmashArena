---
import { ArrowUp, Clock, Mail, MapPin, MessageCircle } from "@lucide/astro";
import { contact } from "../data/contact";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();

const footerNav = [
  { label: "Home", href: "/" },
  { label: "Courts", href: "/#courts" },
  { label: "Pricing", href: "/#pricing" },
  { label: "Facilities", href: "/#facilities" },
  { label: "Location", href: "/#location" },
  { label: "Booking", href: "/booking" },
  { label: "My Bookings", href: "/my-bookings" },
];
---

<footer class="relative border-t border-white/8 bg-[#08090b]">
  <div class="container-x py-14 md:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="max-w-sm">
        <a href="/" class="flex items-center gap-2.5" aria-label="SMASH ARENA — beranda">
          <span class="text-primary">
            <Logo class="size-9" />
          </span>
          <span class="font-display text-lg font-extrabold uppercase leading-none tracking-[0.08em]">
            <span class="text-white">Smash</span><span class="text-primary"> Arena</span>
          </span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
          {contact.tagline}. Enam lapangan premium, buka setiap hari, siap menemani smash terbaikmu.
        </p>

        <div class="mt-5 flex items-center gap-3">
          <a
            href={contact.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Hubungi Smash Arena via WhatsApp"
            class="flex size-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white/70 outline-none transition-all hover:border-primary/50 hover:text-primary focus-visible:ring-2 focus-visible:ring-ring"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path>
            </svg>
          </a>
          <a
            href={contact.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Kunjungi Instagram Smash Arena"
            class="flex size-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white/70 outline-none transition-all hover:border-primary/50 hover:text-primary focus-visible:ring-2 focus-visible:ring-ring"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
              ></path>
            </svg>
          </a>
          <a
            href={contact.emailHref}
            aria-label="Email Smash Arena"
            class="flex size-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white/70 outline-none transition-all hover:border-primary/50 hover:text-primary focus-visible:ring-2 focus-visible:ring-ring"
          >
            <Mail class="size-5" aria-hidden="true"></Mail>
          </a>
        </div>
      </div>

      <nav aria-label="Navigasi footer">
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-white">Navigasi</h3>
        <ul class="mt-5 space-y-3">
          {
            footerNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-muted-foreground outline-none transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-ring rounded"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-white">Kontak</h3>
        <ul class="mt-5 space-y-3.5 text-sm">
          <li>
            <a
              href={contact.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 text-muted-foreground outline-none transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-ring rounded"
            >
              <MessageCircle class="size-4 shrink-0 text-primary" aria-hidden="true" />
              WhatsApp — {contact.phoneLabel}
            </a>
          </li>
          <li>
            <a
              href={contact.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 text-muted-foreground outline-none transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-ring rounded"
            >
              <span class="inline-block size-4 shrink-0 text-primary" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" class="size-4">
                  <path
                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
                  ></path>
                </svg>
              </span>
              Instagram — @smasharena.id
            </a>
          </li>
          <li>
            <a
              href={contact.emailHref}
              class="flex items-center gap-2.5 text-muted-foreground outline-none transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-ring rounded"
            >
              <Mail class="size-4 shrink-0 text-primary" aria-hidden="true" />
              {contact.email}
            </a>
          </li>
          <li class="flex items-start gap-2.5 text-muted-foreground">
            <MapPin class="mt-0.5 size-4 shrink-0 text-primary" aria-hidden="true" />
            <span>{contact.address.join(", ")}</span>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-white">Jam Operasional</h3>
        <div class="mt-5 rounded-2xl border border-white/8 bg-white/[0.03] p-4">
          <p class="flex items-center gap-2 text-sm font-bold text-white">
            <Clock class="size-4 text-primary" aria-hidden="true" />
            {contact.hoursLabel}
          </p>
          <p class="mt-2 font-display text-2xl font-extrabold text-primary">{contact.hours}</p>
          <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
            Resepsionis melayani booking hingga 30 menit sebelum tutup.
          </p>
        </div>

        <a
          href="/booking"
          class="mt-4 inline-flex h-11 w-full items-center justify-center gap-2 rounded-full bg-primary text-sm font-bold text-primary-foreground shadow-[0_12px_28px_-14px_rgba(163,230,53,0.9)] outline-none transition-all hover:bg-[#b5f04a] focus-visible:ring-2 focus-visible:ring-ring active:scale-[0.98]"
        >
          Booking Sekarang
        </a>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/8 pt-7 sm:flex-row"
    >
      <p class="text-xs text-muted-foreground">
        © {year} Smash Arena. All rights reserved.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground outline-none transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-ring rounded"
      >
        Kembali ke atas
        <ArrowUp class="size-3.5" aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>
