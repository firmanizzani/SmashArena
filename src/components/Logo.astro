---
interface Props {
  class?: string;
}

const { class: className = "size-9" } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  fill="none"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <g transform="rotate(22 16 16)">
    <path
      d="M10.2 3.6h11.6l-3.7 12.4a1 1 0 0 1-1 .75h-2.2a1 1 0 0 1-1-.75L10.2 3.6Z"
      fill="currentColor"></path>
    <path
      d="M16 4.6v11.6M12.6 7.4l1.5 8.3M19.4 7.4l-1.5 8.3"
      stroke="#0a0b0d"
      stroke-opacity="0.35"
      stroke-width="1.1"
      stroke-linecap="round"></path>
    <path
      d="M12.4 16.4h7.2"
      stroke="#0a0b0d"
      stroke-opacity="0.45"
      stroke-width="1.4"
      stroke-linecap="round"></path>
    <circle cx="16" cy="21.4" r="4" fill="currentColor"></circle>
    <circle cx="16" cy="21.4" r="4" stroke="#0a0b0d" stroke-opacity="0.25" stroke-width="1"
    ></circle>
  </g>
</svg>
