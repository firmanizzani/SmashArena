---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  id?: string;
}

const { eyebrow, title, description, align = "left", id } = Astro.props;
const isCenter = align === "center";
---

<div class:list={["max-w-2xl", isCenter && "mx-auto text-center"]}>
  <span class="eyebrow reveal">{eyebrow}</span>
  <h2
    id={id}
    class="reveal reveal-delay-1 mt-5 font-display text-3xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-4xl md:text-5xl"
  >
    {title}
  </h2>
  {
    description && (
      <p class="reveal reveal-delay-2 mt-5 text-base leading-relaxed text-muted-foreground md:text-lg">
        {description}
      </p>
    )
  }
</div>
