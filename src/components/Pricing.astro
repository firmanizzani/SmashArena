---
import { ArrowUpRight, Check, Sparkles } from "@lucide/astro";
import { pricingPlans } from "../data/pricing";
import SectionHeading from "./SectionHeading.astro";
---

<section id="pricing" class="section-pad relative bg-white/[0.015]" aria-labelledby="pricing-title">
  <div class="container-x">
    <SectionHeading
      id="pricing-title"
      eyebrow="Daftar Harga"
      title="Simple, Transparent Pricing"
      description="Tidak ada biaya tersembunyi. Pilih paket yang sesuai, bayar di tempat, dan langsung bermain."
      align="center"
    />

    <div class="mt-14 grid gap-6 md:grid-cols-3 lg:gap-8">
      {
        pricingPlans.map((plan, index) => (
          <article
            class:list={[
              "reveal relative flex flex-col rounded-3xl border p-5 transition-all duration-300 sm:p-7 md:p-8",
              plan.highlighted
                ? "border-primary/50 bg-gradient-to-b from-primary/[0.09] to-card shadow-[0_40px_80px_-40px_rgba(163,230,53,0.55)] lg:-translate-y-3"
                : "border-white/8 bg-card hover:-translate-y-1 hover:border-white/20",
              `reveal-delay-${Math.min(index + 1, 4)}`,
            ]}
          >
            {plan.badge && (
              <span class="absolute -top-3.5 left-1/2 inline-flex -translate-x-1/2 items-center gap-1.5 rounded-full bg-primary px-4 py-1.5 text-[0.7rem] font-extrabold uppercase tracking-[0.14em] text-primary-foreground shadow-[0_12px_28px_-12px_rgba(163,230,53,0.9)]">
                <Sparkles class="size-3" aria-hidden="true" />
                {plan.badge}
              </span>
            )}

            <header class="border-b border-white/8 pb-6">
              <h3 class="font-display text-lg font-extrabold uppercase tracking-[0.16em] text-white">
                {plan.name}
              </h3>
              <p class="mt-3 min-h-[3rem] text-sm leading-relaxed text-muted-foreground">
                {plan.description}
              </p>
              <p class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="font-display text-[1.9rem] font-extrabold leading-none text-white lg:text-[2.4rem] xl:text-[2.75rem]">
                  {plan.priceLabel}
                </span>
                <span class="text-sm font-semibold text-muted-foreground">/ {plan.period}</span>
              </p>
            </header>

            <ul class="mt-6 flex-1 space-y-3.5">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-white/85">
                  <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary">
                    <Check class="size-3" aria-hidden="true" />
                  </span>
                  {feature}
                </li>
              ))}
            </ul>

            <a
              href="/booking"
              data-book-court={plan.courtId}
              class:list={[
                "mt-8 inline-flex h-12 w-full items-center justify-center gap-2 rounded-full text-sm font-bold outline-none transition-all duration-200 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background active:scale-[0.98] sm:w-auto",
                plan.highlighted
                  ? "bg-primary text-primary-foreground shadow-[0_14px_32px_-12px_rgba(163,230,53,0.9)] hover:bg-[#b5f04a]"
                  : "border border-white/15 bg-white/5 text-white hover:border-primary/50 hover:bg-primary/10 hover:text-primary",
              ]}
            >
              Book Now
              <ArrowUpRight class="size-4" aria-hidden="true" />
            </a>
          </article>
        ))
      }
    </div>

    <p class="reveal mt-10 text-center text-sm text-muted-foreground">
      Semua harga sudah termasuk pajak. Dapatkan potongan <span class="font-semibold text-primary">10%</span> khusus member bulanan.
    </p>
  </div>
</section>
