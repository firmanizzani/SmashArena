---
import { ArrowUpRight, Menu, X } from "@lucide/astro";
import { bookingHref, navigation } from "../data/navigation";
import Logo from "./Logo.astro";
import { AuthNav } from "./nav/AuthNav";
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="container-x flex h-16 items-center justify-between gap-4 md:h-20">
    <a
      href="/"
      class="group flex items-center gap-2.5 rounded-xl outline-none focus-visible:ring-2 focus-visible:ring-ring"
      aria-label="SMASH ARENA — kembali ke beranda"
    >
      <span class="text-primary transition-transform duration-300 group-hover:-rotate-12">
        <Logo class="size-8 md:size-9" />
      </span>
      <span class="font-display text-lg font-extrabold uppercase leading-none tracking-[0.08em] md:text-xl">
        <span class="text-white">Smash</span><span class="text-primary"> Arena</span>
      </span>
    </a>

    <nav class="hidden items-center lg:flex" aria-label="Navigasi utama">
      <ul class="flex items-center gap-1">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link rounded-full px-4 py-2 text-sm font-medium text-white/75 outline-none transition-colors hover:text-white focus-visible:ring-2 focus-visible:ring-ring"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2.5">
      <AuthNav client:load />

      <a
        href={bookingHref}
        class="hidden h-10 items-center gap-1.5 rounded-full bg-primary px-5 text-sm font-bold text-primary-foreground shadow-[0_10px_28px_-10px_rgba(163,230,53,0.7)] outline-none transition-all duration-200 hover:bg-[#b5f04a] hover:shadow-[0_14px_32px_-10px_rgba(163,230,53,0.9)] focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background active:scale-[0.98] sm:inline-flex"
      >
        Booking Sekarang
        <ArrowUpRight class="size-4" aria-hidden="true" />
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="flex size-10 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white outline-none transition-colors hover:border-primary/50 hover:text-primary focus-visible:ring-2 focus-visible:ring-ring lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Buka menu navigasi"
      >
        <span class="menu-icon-open">
          <Menu class="size-5" aria-hidden="true" />
        </span>
        <span class="menu-icon-close hidden">
          <X class="size-5" aria-hidden="true" />
        </span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-background/95 backdrop-blur-xl lg:hidden"
  >
    <nav class="container-x py-5" aria-label="Navigasi mobile">
      <ul class="flex flex-col gap-1">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3.5 text-base font-semibold text-white/85 outline-none transition-colors hover:bg-white/5 hover:text-primary focus-visible:ring-2 focus-visible:ring-ring"
              >
                {item.label}
                <ArrowUpRight class="size-4 text-muted-foreground" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={bookingHref}
        class="mt-4 flex h-12 w-full items-center justify-center gap-2 rounded-full bg-primary text-sm font-bold text-primary-foreground shadow-[0_10px_28px_-10px_rgba(163,230,53,0.7)] outline-none transition-all hover:bg-[#b5f04a] focus-visible:ring-2 focus-visible:ring-ring active:scale-[0.98]"
      >
        Booking Sekarang
        <ArrowUpRight class="size-4" aria-hidden="true" />
      </a>

      <div class="mt-3">
        <AuthNav client:load variant="mobile" />
      </div>
    </nav>
  </div>
</header>

<style>
  #site-header.is-scrolled {
    background-color: rgba(10, 11, 13, 0.72);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 12px 40px -24px rgba(0, 0, 0, 0.9);
  }

  #site-header.menu-open {
    background-color: rgba(10, 11, 13, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  #site-header.is-scrolled .nav-link:hover {
    color: #a3e635;
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const openIcon = toggle?.querySelector<HTMLElement>(".menu-icon-open");
  const closeIcon = toggle?.querySelector<HTMLElement>(".menu-icon-close");

  const updateHeader = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 16);
  };

  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  let isOpen = false;

  const setMenuOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    isOpen = open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Tutup menu navigasi" : "Buka menu navigasi");
    menu.classList.toggle("hidden", !open);
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
    header?.classList.toggle("menu-open", open);
    document.body.style.overflow = open ? "hidden" : "";
  };

  toggle?.addEventListener("click", () => setMenuOpen(!isOpen));

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen) {
      setMenuOpen(false);
      toggle?.focus();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024 && isOpen) setMenuOpen(false);
  });
</script>
