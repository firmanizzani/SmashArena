---
import { Clock, Mail, MapPin, Navigation, Phone } from "@lucide/astro";
import { contact } from "../data/contact";
import SectionHeading from "./SectionHeading.astro";

const contactItems = [
  { icon: MapPin, label: "Alamat", value: contact.addressFull },
  { icon: Clock, label: "Jam Operasional", value: `${contact.hoursLabel} · ${contact.hours}` },
  { icon: Phone, label: "Telepon / WhatsApp", value: contact.phoneLabel, href: contact.phoneHref },
  { icon: Mail, label: "Email", value: contact.email, href: contact.emailHref },
];
---

<section id="location" class="section-pad relative" aria-labelledby="location-title">
  <div class="container-x">
    <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <SectionHeading
          id="location-title"
          eyebrow="Lokasi & Kontak"
          title="Visit Smash Arena"
          description="Mudah dijangkau dari berbagai arah, dengan area parkir luas dan akses langsung ke resepsionis."
        />

        <ul class="mt-9 space-y-3">
          {
            contactItems.map((item, index) => {
              const Icon = item.icon;
              const content = (
                <span class="flex items-start gap-4 rounded-2xl border border-white/8 bg-card/70 p-4 transition-all duration-300 hover:border-primary/35">
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary ring-1 ring-primary/25">
                    <Icon class="size-5" aria-hidden="true" />
                  </span>
                  <span>
                    <span class="block text-[0.7rem] font-bold uppercase tracking-[0.16em] text-muted-foreground">
                      {item.label}
                    </span>
                    <span class="mt-1 block text-sm font-semibold leading-relaxed text-white">
                      {item.value}
                    </span>
                  </span>
                </span>
              );

              return (
                <li class={`reveal reveal-delay-${Math.min(index + 1, 4)}`}>
                  {item.href ? (
                    <a
                      href={item.href}
                      class="block outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-2xl"
                    >
                      {content}
                    </a>
                  ) : (
                    content
                  )}
                </li>
              );
            })
          }
        </ul>

        <a
          href={contact.directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="reveal mt-6 inline-flex h-12 items-center justify-center gap-2 rounded-full bg-primary px-7 text-sm font-bold text-primary-foreground shadow-[0_14px_32px_-12px_rgba(163,230,53,0.85)] outline-none transition-all duration-200 hover:bg-[#b5f04a] focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background active:scale-[0.98]"
        >
          Get Directions
          <Navigation class="size-4" aria-hidden="true" />
        </a>
      </div>

      <div class="reveal" data-reveal="right">
        <div class="overflow-hidden rounded-3xl border border-white/10 bg-card shadow-[0_40px_80px_-40px_rgba(0,0,0,0.9)]">
          <div class="flex items-center justify-between gap-3 border-b border-white/8 px-5 py-4">
            <div class="flex items-center gap-2.5">
              <span class="size-2.5 rounded-full bg-red-400/80"></span>
              <span class="size-2.5 rounded-full bg-amber-400/80"></span>
              <span class="size-2.5 rounded-full bg-primary/80"></span>
            </div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground">
              {contact.brand} — Peta Lokasi
            </p>
          </div>

          <iframe
            src={contact.mapEmbedUrl}
            title="Peta lokasi Smash Arena di Kebayoran Baru, Jakarta Selatan"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            class="h-[22rem] w-full border-0 grayscale-[0.35] transition-all duration-500 hover:grayscale-0 md:h-[26rem]">
          </iframe>

          <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/8 px-5 py-4">
            <div>
              <p class="font-display text-sm font-extrabold text-white">{contact.brand}</p>
              <p class="text-xs text-muted-foreground">{contact.address.join(", ")}</p>
            </div>
            <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1.5 text-xs font-bold text-primary ring-1 ring-primary/30">
              <span class="animate-live-dot size-1.5 rounded-full bg-primary"></span>
              {contact.hours}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
